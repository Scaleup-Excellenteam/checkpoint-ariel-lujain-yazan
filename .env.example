# Copy this file to .env and replace every placeholder. Never commit .env.
# Bridge: use the address of the upstream chat server. On a teammate's
# computer, change just this value to the server computer's LAN IP/hostname.
# This file is loaded automatically by the Python server and bridge; it is not
# loaded by Vite and none of these values are exposed to browser JavaScript.
CHAT_SERVER_URL=ws://127.0.0.1:8000/
# Browser origins that may connect to the local bridge.
CHAT_UI_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:5500,http://localhost:5500
# Server: fill these locally; never commit credentials or secrets.
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/DATABASE
# Generate with: .venv/bin/python -c 'import secrets; print(secrets.token_urlsafe(32))'
JWT_SECRET_KEY=REPLACE_WITH_A_PRIVATE_RANDOM_SECRET_AT_LEAST_32_BYTES_LONG
# Optional. URL-containing messages are blocked when this is blank or unavailable.
VIRUSTOTAL_API_KEY=
