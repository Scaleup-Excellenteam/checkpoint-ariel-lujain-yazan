# Copy to .env, fill private values, then: set -a; source .env; set +a
# Bridge: replace the host to connect to a teammate's server.
CHAT_SERVER_URL=ws://127.0.0.1:8000/
CHAT_UI_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:5500,http://localhost:5500
# Server: fill locally; never commit credentials or secrets.
DATABASE_URL=
JWT_SECRET_KEY=
